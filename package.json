{
  "name": "mikopark",
  "version": "0.1.0",
  "private": true,
  "description": "MikoPark \u2014 a team workspace where people and AI agents collaborate (GenTeam-style).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web,voice -c blue,magenta,green \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:voice\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev:voice": "node scripts/voice-engine.mjs",
    "voice:setup": "bash scripts/voice-setup.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
